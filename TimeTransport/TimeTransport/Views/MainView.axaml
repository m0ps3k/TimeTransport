<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TimeTransport.ViewModels"
             xmlns:models="using:TimeTransport.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TimeTransport.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid ColumnDefinitions="*, *" Margin="10" Grid.Column="0" Grid.ColumnSpan="2">
            <Button Content="Туда" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ChangeToForwardCommand}"></Button>
            <Button Content="Обратно" Grid.Column="1" HorizontalAlignment="Stretch"  HorizontalContentAlignment="Center" Command="{Binding ChangeToBackwardCommand}"></Button>
        </Grid>


        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="50, *" IsVisible="{Binding DirectionIsBackward}">
            <ComboBox Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}" ></ComboBox>
            <ScrollViewer Grid.Row="1">
                <Grid RowDefinitions="Auto,Auto,*" Margin="10">
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding TimetableBefore}"/>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding TimetableNow}"/>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding TimetableAfter}"/>
                </Grid>
            </ScrollViewer>
        </Grid>


        <ScrollViewer Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding !DirectionIsBackward}">
            <Grid RowDefinitions="Auto,Auto,*" Margin="10">
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding TimetableBefore}"/>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding TimetableNow}"/>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding TimetableAfter}"/>
            </Grid>
        </ScrollViewer>
    </Grid>


</UserControl>
