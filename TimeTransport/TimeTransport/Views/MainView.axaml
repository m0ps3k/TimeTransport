<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeTransport.ViewModels"
             x:Class="TimeTransport.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#F7F8FC">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Margin="20"
          MaxWidth="720"
          HorizontalAlignment="Stretch">

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                    Margin="0,4,0,20"
                    Spacing="4">

            <TextBlock Classes="pageTitle"
                       Text="Расписание"/>

            <TextBlock Classes="subtitle"
                       Text="Отправления на выбранной остановке"/>
        </StackPanel>

        <!-- Направление -->
        <Border Grid.Row="1"
                Background="#EBEEF5"
                CornerRadius="16"
                Padding="4"
                Margin="0,0,0,16">

            <Grid ColumnDefinitions="*,*">

                <Button Grid.Column="0"
                        Margin="0,0,2,0"
                        Classes="direction"
                        Classes.active="{Binding !DirectionIsBackward}"
                        Content="Туда"
                        Command="{Binding ChangeToForwardCommand}"/>

                <Button Grid.Column="1"
                        Margin="2,0,0,0"
                        Classes="direction"
                        Classes.active="{Binding DirectionIsBackward}"
                        Content="Обратно"
                        Command="{Binding ChangeToBackwardCommand}"/>
            </Grid>
        </Border>

        <!-- Остановка -->
        <StackPanel Grid.Row="2"
                    Spacing="8"
                    Margin="0,0,0,16"
                    IsVisible="{Binding DirectionIsBackward}">

            <TextBlock Classes="subtitle"
                       Text="ОСТАНОВКА"/>

            <ComboBox Classes="stopPicker"
                      ItemsSource="{Binding Stops}"
                      SelectedItem="{Binding SelectedStop}"
                      PlaceholderText="Выберите остановку"/>
        </StackPanel>

        <!-- Карточки -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>
                <ItemsControl Classes="before"
                              ItemsSource="{Binding TimetableBefore}"/>

                <ItemsControl Classes="now"
                              ItemsSource="{Binding TimetableNow}"/>

                <ItemsControl Classes="after"
                              ItemsSource="{Binding TimetableAfter}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>