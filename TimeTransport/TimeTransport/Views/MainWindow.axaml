<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTransport.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:TimeTransport.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TimeTransport.Views.MainWindow"
        x:DataType="vm:MainWindowModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Расписание транспорта">
        <Window.DataTemplates>
                <DataTemplate x:DataType="vm:MainViewModel">
                        <views:MainView/>
                </DataTemplate>
        </Window.DataTemplates>
        <ContentControl Name="MainContentControl" Content="{Binding ContentValue}"/>
</Window>
